<Window x:Class="CarParkManager.DriverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CarParkManager"
        mc:Ignorable="d"
        Title="Водитель" Height="760" Width="900"
        MinHeight="700" MinWidth="820"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Name="HeaderText" Text="Заполните форму" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,22,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="ФИО" VerticalAlignment="Center" Margin="0,0,14,16" />
                    <TextBox Grid.Row="0" Grid.Column="1" Name="FullNameBox" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Name="FullNameError" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="12,0,0,12" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Водительское удостоверение" VerticalAlignment="Center" Margin="0,0,14,16" />
                    <TextBox Grid.Row="1" Grid.Column="1" Name="LicenseBox" Text="{Binding LicenseNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Name="LicenseError" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="12,0,0,12" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Телефон" VerticalAlignment="Center" Margin="0,0,14,16" />
                    <TextBox Grid.Row="2" Grid.Column="1" Name="PhoneBox" Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Name="PhoneError" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="12,0,0,12" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Стаж, лет" VerticalAlignment="Center" Margin="0,0,14,16" />
                    <TextBox Grid.Row="3" Grid.Column="1" Name="ExperienceBox" Text="{Binding Experience, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Name="ExperienceError" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="12,0,0,12" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Электронная почта" VerticalAlignment="Center" Margin="0,0,14,16" />
                    <TextBox Grid.Row="4" Grid.Column="1" Name="EmailBox" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Name="EmailError" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="12,0,0,12" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Name="PasswordLabel" Text="Пароль" VerticalAlignment="Center" Margin="0,0,14,16" />
                    <PasswordBox Grid.Row="5" Grid.Column="1" Name="PasswordInput" Margin="0,0,0,12" />
                    <TextBlock Grid.Row="5" Grid.Column="2" Name="PasswordError" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="12,0,0,12" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Повтор пароля" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <PasswordBox Grid.Row="6" Grid.Column="1" Name="RepeatInput" />
                    <TextBlock Grid.Row="6" Grid.Column="2" Name="RepeatError" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="12,0,0,0" VerticalAlignment="Center" />
                </Grid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="Отмена" MinWidth="110" Click="Cancel_Click" />
                    <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" MinWidth="130" Margin="10,0,0,0" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
